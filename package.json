{
  "name": "stillport",
  "version": "0.2.0",
  "description": "Your photos, within reach. Apple Photos and Google Photos for AI agents.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "stillport": "src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baney75/stillport.git"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "package:plugin": "bun scripts/package-plugin.ts",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
